# Copy to prod.env and replace all placeholder secrets.
MYSQL_PASSWORD=replace-with-long-random-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-long-random-root-password

FOSTER_AGENT_TOKEN=replace-with-long-random-agent-token
FOSTER_ADMIN_TOKEN=replace-with-long-random-admin-token

FOSTER_HTTP_PORT=8080
FOSTER_SCHEDULER_INTERVAL_SECONDS=15
FOSTER_RESOURCE_MIN_REMAINING_MINUTES=330
FOSTER_RESOURCE_RETRY_SECONDS=60
RUST_LOG=info
