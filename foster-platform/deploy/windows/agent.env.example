# Copy to agent.env in the same directory as foster-agent.exe.

FOSTER_SERVER_WS_URL=ws://YOUR_SERVER_HOST:8080/agent/ws
FOSTER_AGENT_TOKEN=must-match-server-agent-token
FOSTER_AGENT_ID=host-01-agent
FOSTER_HOST_ID=REPLACE_WITH_BOOTSTRAPPED_HOST_ID
FOSTER_COMMAND_JOURNAL_PATH=C:\\FosterAgent\\command-journal.json

FOSTER_OAS_BASE_URL=http://127.0.0.1:22270
FOSTER_OAS_TIMEOUT_SECONDS=180
FOSTER_LOGIN_QR_TTL_SECONDS=120
FOSTER_LOGIN_IDENTITY_TIMEOUT_SECONDS=300
FOSTER_LOGIN_POLL_INTERVAL_SECONDS=2

# Use LDPlayer's bundled adb.exe or another adb that can see the same instances.
# Replace the path below with the actual LDPlayer installation directory.
FOSTER_ADB_PATH=C:\\LDPlayer\\LDPlayer9\\adb.exe

# Shortest-path LDPlayer setup:
# - startProgram/stopProgram use ldconsole.exe and a fixed --index
# - adbSerial MUST be the exact serial shown by "adb devices"
#   (index 0 commonly appears as emulator-5554; do not guess if your machine differs)
# - packageName is the full-channel Onmyoji package used for QR login
# - oasConfigName must point at the same LDPlayer instance in OAS
#
# Add more entries for index 1/2/... when you add more LDPlayer instances.
# Keep the JSON on one line.
FOSTER_EMULATORS_JSON=[{"emulatorCode":"ld-00","driverType":"LDPLAYER","adbSerial":"emulator-5554","oasConfigName":"oas-ld-00","packageName":"com.netease.onmyoji.wyzymnqsd_cps","startProgram":"C:\\LDPlayer\\LDPlayer9\\ldconsole.exe","startArgs":["launch","--index","0"],"stopProgram":"C:\\LDPlayer\\LDPlayer9\\ldconsole.exe","stopArgs":["quit","--index","0"],"loginPrepareProgram":null,"loginPrepareArgs":[],"loginPrepareDelayMs":8000}]

RUST_LOG=info
