# Copy to agent.env in the same directory as foster-agent.exe.

FOSTER_SERVER_WS_URL=ws://YOUR_SERVER_HOST:8080/agent/ws
FOSTER_AGENT_TOKEN=must-match-server-agent-token
FOSTER_AGENT_ID=host-01-agent
FOSTER_HOST_ID=REPLACE_WITH_BOOTSTRAPPED_HOST_ID
# Optional. Start-FosterAgent.ps1 runs in this directory, so the default is ./command-journal.json.
FOSTER_COMMAND_JOURNAL_PATH=C:\\FosterAgent\\command-journal.json

FOSTER_OAS_BASE_URL=http://127.0.0.1:22270
FOSTER_OAS_TIMEOUT_SECONDS=180
FOSTER_LOGIN_QR_TTL_SECONDS=120
FOSTER_LOGIN_IDENTITY_TIMEOUT_SECONDS=300
FOSTER_LOGIN_POLL_INTERVAL_SECONDS=2

# Absolute path is recommended on Windows. MuMu ships its own adb.
FOSTER_ADB_PATH=C:\\Program Files\\Netease\\MuMu\\nx_main\\adb.exe

# MuMu full-channel login preparation. Only com.netease.onmyoji.wyzymnqsd_cps
# may ever be launched; the ordinary package com.netease.onmyoji is uninstalled
# from every discovered MuMu instance at the start of login preparation
# (destructive: its local data is deleted).
FOSTER_MUMU_CLI_PATH=C:\\Program Files\\Netease\\MuMu\\nx_main\\mumu-cli.exe
FOSTER_MUMU_APP_MARKET_PACKAGE=com.mumu.store
FOSTER_MUMU_APP_MARKET_ACTIVITY=com.mumu.store/.MainActivity
FOSTER_FULL_CHANNEL_PACKAGE=com.netease.onmyoji.wyzymnqsd_cps
FOSTER_NORMAL_PACKAGE=com.netease.onmyoji
FOSTER_RESOLUTION_WIDTH=1280
FOSTER_RESOLUTION_HEIGHT=720
FOSTER_MUMU_COMMAND_TIMEOUT_SECONDS=30
FOSTER_MUMU_MARKET_TIMEOUT_SECONDS=600
FOSTER_MUMU_MARKET_POLL_SECONDS=2
FOSTER_MUMU_LAUNCH_WAIT_SECONDS=120
FOSTER_MUMU_LAUNCH_SETTLE_SECONDS=5

# Keep JSON on one line.
# packageName must stay null: the agent launches the validated full-channel
# package itself. adbSerial must match the MuMu instance's reported endpoint.
FOSTER_EMULATORS_JSON=[{"emulatorCode":"emu-01","adbSerial":"127.0.0.1:16384","oasConfigName":"oas-emu-01","packageName":null,"startProgram":null,"startArgs":[],"stopProgram":null,"stopArgs":[],"loginPrepareProgram":null,"loginPrepareArgs":[],"loginPrepareDelayMs":0}]

RUST_LOG=info
