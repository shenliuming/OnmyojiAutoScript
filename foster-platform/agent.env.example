# Rust Server WebSocket
FOSTER_SERVER_WS_URL=ws://127.0.0.1:8080/agent/ws
FOSTER_AGENT_TOKEN=replace-me
FOSTER_AGENT_ID=host-01-agent
FOSTER_HOST_ID=1

# Local OAS FastAPI
FOSTER_OAS_BASE_URL=http://127.0.0.1:22270
FOSTER_OAS_TIMEOUT_SECONDS=180

# Login flow
FOSTER_LOGIN_QR_TTL_SECONDS=120
FOSTER_LOGIN_IDENTITY_TIMEOUT_SECONDS=300
FOSTER_LOGIN_POLL_INTERVAL_SECONDS=2

# ADB executable. On Windows this may be an absolute path.
FOSTER_ADB_PATH=adb

# JSON must be one line when used directly as an environment variable.
# start/stop/loginPrepare are optional vendor hooks.
# loginPrepareProgram should navigate the selected emulator to a screen
# containing the game QR code before Agent captures the PNG screenshot.
FOSTER_EMULATORS_JSON=[{"emulatorCode":"emu-01","adbSerial":"127.0.0.1:16384","oasConfigName":"oas-emu-01","packageName":"com.netease.onmyoji","startProgram":null,"startArgs":[],"stopProgram":null,"stopArgs":[],"loginPrepareProgram":null,"loginPrepareArgs":[],"loginPrepareDelayMs":3000}]
